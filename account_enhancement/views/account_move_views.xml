<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_filter_inherit_payment_status" model="ir.ui.view">
        <field name="name">account.move.search.inherit.payment.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group/filter[@name='status']" position="after">
                <filter name="group_by_payment_state"
                        string="Payment Status"
                        context="{'group_by': 'payment_state'}"/>
            </xpath>
        </field>
    </record>
</odoo>
