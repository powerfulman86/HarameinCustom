<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="external_layout_inherit_reg_vat" inherit_id="web.external_layout">
        <!-- Match the first available report wrapper among several common containers -->
        <xpath expr="(//main[contains(concat(' ', normalize-space(@class), ' '), ' o_report_layout ')])[1] |
                     (//div[contains(concat(' ', normalize-space(@class), ' '), ' o_report_layout ')])[1] |
                     (//div[contains(concat(' ', normalize-space(@class), ' '), ' article ')])[1] |
                    (//div[contains(concat(' ', normalize-space(@class), ' '), ' page ')])[1]
                    " position="inside">
            <t t-if="company and (company.company_registry or company.vat)">
                <div class="mb-1 small text-muted">
                    <t t-if="company.company_registry">
                        <span>Registration No:</span>
                        <span t-esc="company.company_registry"/>
                    </t>
                    <t t-if="company.vat">
                        <span class="ms-3">VAT:</span>
                        <span t-esc="company.vat"/>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>


