<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="external_layout_inherit_reg_vat"
              inherit_id="web.external_layout_standard">
        <!-- Add extra <li> items inside the company address block -->
        <xpath expr="//div[@name='company_address']//ul" position="inside">
            <li t-if="company.company_registry">
                <span>Registration No:</span>
                <span t-esc="company.company_registry"/>
            </li>

            <!-- Show VAT only if not already shown by 'forced_vat' in parent -->
            <li t-if="(not forced_vat) and company.vat">
                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                <span t-esc="company.vat"/>
            </li>
        </xpath>
    </template>
</odoo>
